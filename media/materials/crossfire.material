// Original Crossfire palette; no external images or mesh material aliases.
// All surfaces use the existing GL3+/D3D9 base shader and flat normal map.
import base_material from "materials/base.material"

material Crossfire/Porcelain : base_material
{
	set $diffuseCol "0.76 0.72 0.62 1"
	set $specularCol "0.14 0.13 0.11"
	set $shininess "44"
}

material Crossfire/Ivory : base_material
{
	set $diffuseCol "0.9 0.86 0.73 1"
	set $specularCol "0.18 0.17 0.14"
	set $shininess "48"
}


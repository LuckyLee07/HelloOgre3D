material Crossfire/ServicePad
{
	receive_shadows off
	technique
	{
		pass
		{
			lighting off
			cull_hardware none
			scene_blend alpha_blend
			depth_check on
			depth_write off
			vertex_program_ref relay_overlay_vs {}
			fragment_program_ref relay_overlay_fs
			{
				param_named tint float4 1 1 1 1
			}
			texture_unit overlayMap
			{
				texture textures/crossfire/service_pad.png
				tex_address_mode clamp
				filtering trilinear
			}
		}
	}
}


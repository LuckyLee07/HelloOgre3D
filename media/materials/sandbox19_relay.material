// Original Sandbox19 palette, reusing CC0 Nobiax surface textures.
// Source notices: media/textures/nobiax_textures/LICENSE.txt and
// media/textures/nobiax_modular/LICENSE.txt. No shared material is overridden.

// Ogre inheritance resolves AST definitions in this script or explicit imports;
// an already-created material in the resource manager is not an inheritance base.
import base_material from "materials/base.material"

// World-space paving stays continuous across the existing collision floor tiles.
material Relay/Ground
{
	set $groundTint "0.84 0.84 0.82 1"
	technique
	{
		pass
		{
			vertex_program_ref Relay/Ground/vs {}
			fragment_program_ref Relay/Ground/fs
			{
				param_named tint float4 $groundTint
			}
			texture_unit
			{
				texture textures/sandbox19/courtyard_paving_diffuse_v3.png
				filtering anisotropic
				max_anisotropy 8
			}
		}
	}
}
material Relay/MainRoute : Relay/Ground
{
	set $groundTint "0.87 0.87 0.84 1"
}

// Project-authored mesh submaterials. Broad coated-metal panels remain matte;
// lighter ribs and small hardware create form without a tiled window atlas.
material Relay/CrateBody : base_material
{
	set $diffuseCol "0.43 0.49 0.35 1"
	set $specularCol "0.11 0.11 0.08"
	set $shininess "28"
	set_texture_alias diffuseMap textures/sandbox19/supply_case_wear_v1.png
}
material Relay/CratePanel : base_material
{
	set $diffuseCol "0.37 0.42 0.29 1"
	set $specularCol "0.05 0.05 0.04"
	set $shininess "22"
	set_texture_alias diffuseMap textures/sandbox19/supply_case_wear_v1.png
}
material Relay/CrateFrame : base_material
{
	set $diffuseCol "0.53 0.58 0.42 1"
	set $specularCol "0.12 0.12 0.10"
	set $shininess "32"
	set_texture_alias diffuseMap textures/sandbox19/supply_case_wear_v1.png
}
material Relay/CrateRubber : base_material
{
	set $diffuseCol "0.10 0.12 0.11 1"
	set $specularCol "0.01 0.01 0.01"
	set $shininess "8"
}
material Relay/CrateLatch : base_material
{
	set $diffuseCol "0.48 0.49 0.42 1"
	set $specularCol "0.28 0.28 0.25"
	set $shininess "52"
}
material Relay/CrateMark : base_material
{
	set $diffuseCol "0.70 0.68 0.52 1"
	set $specularCol "0.01 0.01 0.01"
	set $shininess "8"
}

material Relay/Concrete : base_material
{
	set $diffuseCol "0.98 0.96 0.89 1"
	set $specularCol "0.03 0.03 0.03"
	set $shininess "12"
	set_texture_alias diffuseMap textures/sandbox19/courtyard_concrete_diffuse.png
	set_texture_alias normalMap textures/sandbox19/courtyard_concrete_normal_v1.png
	set_texture_alias specMap textures/nobiax_textures/ground2Specular.dds
}

material Relay/ConcreteShade : Relay/Concrete
{
	set $diffuseCol "0.84 0.85 0.80 1"
}

material Relay/Window : base_material
{
	set $diffuseCol "1.55 1.40 1.15 1"
	set $specularCol "0.04 0.04 0.04"
	set $shininess "16"
	set_texture_alias diffuseMap textures/nobiax_modular/modularDiffuse.dds
	set_texture_alias normalMap textures/nobiax_modular/modularNormal.dds
	set_texture_alias specMap textures/nobiax_modular/modularSpecular.dds
}

material Relay/ServiceWindow : Relay/Window
{
	set $diffuseCol "0.72 0.68 0.59 1"
}

// Project-specific relay facade panels. The albedo is deliberately neutral-lit;
// scene lighting supplies the final warm/cool separation on both D3D9 and GL.
material Relay/Facade : base_material
{
	set $diffuseCol "0.92 0.90 0.82 1"
	set $specularCol "0.05 0.06 0.05"
	set $shininess "18"
	set_texture_alias diffuseMap textures/sandbox19/relay_facade_diffuse.png
	set_texture_alias normalMap textures/base/baseFlatNormal.dds
	set_texture_alias specMap textures/nobiax_modular/modularSpecular.dds
}

// Procedural caps have no authored atlas UVs: a neutral coated metal avoids
// pulling unrelated windows, ribs and panel strips across thin box faces.
material Relay/Trim : base_material
{
	set $diffuseCol "0.30 0.32 0.27 1"
	set $specularCol "0.10 0.10 0.10"
	set $shininess "28"
}

material Relay/Canopy : base_material
{
	set $diffuseCol "0.64 0.59 0.47 1"
	set $specularCol "0.02 0.02 0.02"
	set $shininess "8"
}

material Relay/EquipmentBox : base_material
{
	set $diffuseCol "0.35 0.40 0.34 1"
	set $specularCol "0.07 0.07 0.07"
	set $shininess "24"
}

material Relay/Cover : base_material
{
	set $diffuseCol "0.92 0.91 0.83 1"
	set $specularCol "0.02 0.02 0.02"
	set $shininess "8"
	set_texture_alias diffuseMap textures/sandbox19/courtyard_concrete_diffuse.png
	set_texture_alias normalMap textures/sandbox19/courtyard_concrete_normal_v1.png
	set_texture_alias specMap textures/nobiax_textures/ground2Specular.dds
}

material Relay/Metal : base_material
{
	set $diffuseCol "0.62 0.74 0.65 1"
	set $specularCol "0.12 0.12 0.12"
	set $shininess "24"
	set_texture_alias diffuseMap textures/nobiax_modular/modularDiffuse.dds
	set_texture_alias normalMap textures/nobiax_modular/modularNormal.dds
	set_texture_alias specMap textures/nobiax_modular/modularSpecular.dds
}

material Relay/Equipment : base_material
{
	set $diffuseCol "0.56 0.69 0.57 1"
	set $specularCol "0.09 0.09 0.09"
	set $shininess "24"
	set_texture_alias diffuseMap textures/nobiax_modular/modularDiffuse.dds
	set_texture_alias normalMap textures/nobiax_modular/modularNormal.dds
	set_texture_alias specMap textures/nobiax_modular/modularSpecular.dds
}

material Relay/SafeMark : base_material
{
	set $diffuseCol "0.20 0.48 0.46 1"
	set $specularCol "0 0 0"
	set $shininess "1"
}

material Relay/GoalMark : base_material
{
	set $diffuseCol "0.72 0.46 0.22 1"
	set $specularCol "0 0 0"
	set $shininess "1"
}

material Relay/RouteMark : base_material
{
	set $diffuseCol "0.64 0.58 0.47 1"
	set $specularCol "0 0 0"
	set $shininess "1"
}

// Muted ochre datum line across the occupied north wings. Kept separate from
// mission-state amber so the architecture never looks like an objective cue.
material Relay/BuildingStripe : base_material
{
	set $diffuseCol "0.56 0.39 0.19 1"
	set $specularCol "0 0 0"
	set $shininess "1"
}

material Relay/Accent : base_material
{
	set $diffuseCol "0.92 0.56 0.20 1"
	set $specularCol "0.02 0.02 0.02"
	set $shininess "4"
}

material Relay/StateOff : base_material
{
	set $diffuseCol "0.16 0.18 0.16 1"
	set $specularCol "0 0 0"
	set $shininess "1"
}

material Relay/StateAmberDim : Relay/Accent
{
	set $diffuseCol "0.38 0.20 0.07 1"
}

material Relay/StateAmberMid : Relay/Accent
{
	set $diffuseCol "0.68 0.36 0.11 1"
}

material Relay/StateAmber : Relay/Accent
{
	set $diffuseCol "1.00 0.60 0.20 1"
}

material Relay/StateCyanDim : Relay/Accent
{
	set $diffuseCol "0.08 0.30 0.30 1"
}

material Relay/StateCyanMid : Relay/Accent
{
	set $diffuseCol "0.10 0.57 0.56 1"
}

material Relay/StateCyan : Relay/Accent
{
	set $diffuseCol "0.18 0.92 0.88 1"
}

// State-driven relay feedback uses the same cross-platform overlay shader and
// project-owned radial mask as the contact layer. It remains render-only.
material Relay/SignalBase
{
	set $signalTint "1 1 1 0"

	receive_shadows off
	technique
	{
		pass
		{
			lighting off
			cull_hardware none
			cull_software none
			scene_blend alpha_blend
			depth_check on
			depth_write off

			vertex_program_ref relay_overlay_vs
			{
			}

			fragment_program_ref relay_overlay_fs
			{
				param_named tint float4 $signalTint
			}

			texture_unit overlayMap
			{
				texture textures/sandbox19/signal_glow.png
				tex_address_mode clamp
				filtering linear linear none
			}
		}
	}
}

material Relay/SignalOff : Relay/SignalBase
{
	set $signalTint "1 1 1 0"
}

material Relay/SignalAmberDim : Relay/SignalBase
{
	set $signalTint "1.00 0.38 0.06 0.070"
}

material Relay/SignalAmberMid : Relay/SignalBase
{
	set $signalTint "1.00 0.44 0.08 0.125"
}

material Relay/SignalAmber : Relay/SignalBase
{
	set $signalTint "1.00 0.52 0.12 0.205"
}

material Relay/SignalCyanDim : Relay/SignalBase
{
	set $signalTint "0.10 0.78 0.78 0.060"
}

material Relay/SignalCyanMid : Relay/SignalBase
{
	set $signalTint "0.12 0.88 0.86 0.105"
}

material Relay/SignalCyan : Relay/SignalBase
{
	set $signalTint "0.18 0.98 0.94 0.175"
}

// Visual-only layers use ObjectFactory::CreateVisualPlane. They never enter
// Bullet, navmesh rasterisation, or AI line-of-sight queries.
material Relay/Vegetation
{
	receive_shadows off
	technique
	{
		pass
		{
			lighting off
			cull_hardware none
			cull_software none
			scene_blend alpha_blend
			depth_check on
			depth_write on
			alpha_rejection greater_equal 128

			vertex_program_ref relay_overlay_vs
			{
			}

			fragment_program_ref relay_overlay_fs
			{
				param_named tint float4 0.72 0.64 0.50 0.92
			}

			texture_unit overlayMap
			{
				texture textures/sandbox19/desert_grass.png
				tex_address_mode clamp
				filtering anisotropic
			}
		}
	}
}

material Relay/ContactShadow
{
	receive_shadows off
	technique
	{
		pass
		{
			lighting off
			cull_hardware none
			scene_blend alpha_blend
			depth_check on
			depth_write off

			vertex_program_ref relay_overlay_vs
			{
			}

			fragment_program_ref relay_overlay_fs
			{
				// The SVG rasteriser stores a deliberately broad alpha field;
				// keep the final contact response restrained in-world.
				param_named tint float4 1 1 1 0.20
			}

			texture_unit overlayMap
			{
				texture textures/sandbox19/contact_shadow.png
				tex_address_mode clamp
				filtering linear linear none
			}
		}
	}
}

material Relay/GroundDust
{
	receive_shadows off
	technique
	{
		pass
		{
			lighting off
			cull_hardware none
			scene_blend alpha_blend
			depth_check on
			depth_write off

			vertex_program_ref relay_overlay_vs
			{
			}

			fragment_program_ref relay_overlay_fs
			{
				// Floor breakup should register as patina, never as a decal plate.
				param_named tint float4 1 1 1 0.065
			}

			texture_unit overlayMap
			{
				texture textures/sandbox19/ground_dust.png
				tex_address_mode clamp
				filtering trilinear
			}
		}
	}
}

// Project-specific desert panorama generated on 2026-09-11 and converted to
// cubemap faces. Prompt and conversion notes: textures/sandbox19/desert_sky/SOURCE.md.
material Relay/Sky
{
	technique
	{
		pass
		{
			lighting off
			depth_write off

			vertex_program_ref skybox_vs_glsl
			{
			}

			fragment_program_ref skybox_fs_glsl
			{
			}

			texture_unit skyboxMap
			{
				cubic_texture textures/sandbox19/desert_sky/DesertRelayFront1024.png textures/sandbox19/desert_sky/DesertRelayBack1024.png textures/sandbox19/desert_sky/DesertRelayLeft1024.png textures/sandbox19/desert_sky/DesertRelayRight1024.png textures/sandbox19/desert_sky/DesertRelayUp1024.png textures/sandbox19/desert_sky/DesertRelayDown1024.png separateUV
				tex_address_mode clamp
			}
		}
	}

	technique
	{
		pass
		{
			lighting off
			depth_write off

			texture_unit
			{
				cubic_texture textures/sandbox19/desert_sky/DesertRelayFront1024.png textures/sandbox19/desert_sky/DesertRelayBack1024.png textures/sandbox19/desert_sky/DesertRelayLeft1024.png textures/sandbox19/desert_sky/DesertRelayRight1024.png textures/sandbox19/desert_sky/DesertRelayUp1024.png textures/sandbox19/desert_sky/DesertRelayDown1024.png separateUV
				tex_address_mode clamp
			}
		}
	}
}

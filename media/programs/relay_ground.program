vertex_program Relay/Ground/vs_glsl glsl
{
	source shaders/relay_ground_vs.glsl
	syntax glsl150
	default_params
	{
		param_named_auto wvpMat worldviewproj_matrix
		param_named_auto wMat world_matrix
		param_named_auto iTWMat inverse_transpose_world_matrix
	}
}
vertex_program Relay/Ground/vs_hlsl hlsl
{
	source shaders/relay_ground.hlsl
	target vs_3_0
	entry_point ground_vs
	default_params
	{
		param_named_auto wvpMat worldviewproj_matrix
		param_named_auto wMat world_matrix
		param_named_auto iTWMat inverse_transpose_world_matrix
	}
}
fragment_program Relay/Ground/fs_glsl glsl
{
	source shaders/relay_ground_fs.glsl
	syntax glsl150
	default_params
	{
		param_named_auto ambient ambient_light_colour
		param_named_auto lightDif0 light_diffuse_colour 0
		param_named_auto lightPos0 light_position 0
		param_named surfaceMap int 0
	}
}
fragment_program Relay/Ground/fs_hlsl hlsl
{
	source shaders/relay_ground.hlsl
	target ps_3_0
	entry_point ground_fs
	default_params
	{
		param_named_auto ambient ambient_light_colour
		param_named_auto lightDif0 light_diffuse_colour 0
		param_named_auto lightPos0 light_position 0
	}
}
vertex_program Relay/Ground/vs unified
{
	delegate Relay/Ground/vs_glsl
	delegate Relay/Ground/vs_hlsl
}
fragment_program Relay/Ground/fs unified
{
	delegate Relay/Ground/fs_glsl
	delegate Relay/Ground/fs_hlsl
}
